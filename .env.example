# Configure these privately in your cloud environment or personal vault.
# Values are full UTF-8 text or base64: followed by base64-encoded UTF-8 bytes.
# Use the prefixed single-line format when the UI strips newlines; never use file paths.
# Enter multiline values directly in the environment UI; do not print them in logs.
LINKEDIN_CANDIDATE_CONTEXT=
LINKEDIN_MASTER_RESUME=

# Optional absolute directories OUTSIDE the Git checkout.
# Defaults: ~/.local/share/linkedin-prep and its state/ subdirectory.
LINKEDIN_PRIVATE_DIR=
LINKEDIN_STATE_DIR=

# Private authorized Notion tracker URL; required for live tracking.
LINKEDIN_NOTION_TRACKER_URL=

# Size-limited editors also support gzip-base64: followed by base64 of gzip-compressed UTF-8 bytes.
